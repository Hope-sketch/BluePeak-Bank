@model IEnumerable<BluePeakBank.Web.Models.Loan>

<h1>Loan</h1>

@if (!Model.Any())
{
    <p>Hey! Catch my heart, ca-ca-catch my heart, BABY!</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Loan Amount</th>
                <th>Loan Interesrt Rate</th>
                <th>Customer ID</th>
                <th>Loan Start Date </th>
                <th>Loan End Date </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var loan in Model)
            {
                <tr>
                    <td>@loan.Amount</td>
                    <td>@loan.InterestRate</td>
                    <td>@loan.CustomerId</td>
                    <td>@loan.StartDate</td>
                    <td>@loan.EndDate</td>
                    <td>@loan.TermInMonths</td>
                    <td>@loan.Id</td>
                </tr>
            }
        </tbody>
    </table>
}